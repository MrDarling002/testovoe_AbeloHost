{
    "name": "blog/app",
    "description": "Blog on pure PHP + Smarty + MySQL without frameworks",
    "type": "project",
    "license": "proprietary",
    "require": {
        "php": ">=8.1",
        "ext-mbstring": "*",
        "ext-pdo": "*",
        "smarty/smarty": "^4.3",
        "vlucas/phpdotenv": "^5.6"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.5",
        "phpstan/phpstan": "^1.10"
    },
    "autoload": {
        "psr-4": {
            "App\\": "src/"
        },
        "files": [
            "src/Support/env.php"
        ]
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "phpunit",
        "stan": "phpstan analyse",
        "seed": "php bin/seed.php",
        "css": "docker run --rm -v $(PWD):/app -w /app sass/sass scss/main.scss public/css/style.css --style=compressed"
    },
    "config": {
        "sort-packages": true
    }
}